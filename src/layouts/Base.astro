---
export interface Props {
  title: string;
  description?: string;
  showBack?: boolean;
}
const { title, description = 'Coding Shuffle Duel — Where Learning Meets RPG Meets Arcade', showBack = false } = Astro.props;
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/',         label: 'Home' },
  { href: '/about',    label: 'About' },
  { href: '/roadmap',  label: 'Roadmap' },
  { href: '/privacy',  label: 'Privacy' },
  { href: '/terms',    label: 'Terms' },
];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>

    <div class="topbar">
      <a href="/" class="topbar-logo">
        <img src="/icons/duel_icon.png" alt="" class="topbar-icon" />
        Coding<span>Shuffle</span>Duel</span>
      </a>

      <!-- Desktop nav -->
      <nav class="topbar-nav">
        {navLinks.map(link => (
          <a
            href={link.href}
            class={`nav-link ${currentPath === link.href ? 'nav-link--active' : ''}`}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Mobile hamburger -->
      <button class="hamburger" id="hamburger" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </div>

    <!-- Mobile drawer -->
    <div class="mobile-drawer" id="drawer">
      <button class="drawer-close" id="drawerClose" aria-label="Close menu">✕</button>
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`drawer-link ${currentPath === link.href ? 'drawer-link--active' : ''}`}
        >
          {link.label}
        </a>
      ))}
    </div>
    <div class="drawer-overlay" id="drawerOverlay"></div>

    <div class="container">
      <slot />
      <footer>
        <p>© {new Date().getFullYear()} Coding Shuffle Duel · <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></p>
      </footer>
    </div>

    <script>
      const hamburger = document.getElementById('hamburger');
      const drawer = document.getElementById('drawer');
      const overlay = document.getElementById('drawerOverlay');
      const close = document.getElementById('drawerClose');

      function openDrawer() {
        drawer?.classList.add('open');
        overlay?.classList.add('open');
        document.body.style.overflow = 'hidden';
      }
      function closeDrawer() {
        drawer?.classList.remove('open');
        overlay?.classList.remove('open');
        document.body.style.overflow = '';
      }

      hamburger?.addEventListener('click', openDrawer);
      close?.addEventListener('click', closeDrawer);
      overlay?.addEventListener('click', closeDrawer);
    </script>

  </body>
</html>

<style>
  /* ── Topbar overrides ───────────────────── */
  .topbar {
    max-width: 100%;
    padding: 14px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .topbar-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .topbar-icon {
    width: 26px;
    height: 26px;
    object-fit: contain;
  }

  /* ── Desktop Nav ────────────────────────── */
  .topbar-nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-link {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--gold);
    background: var(--surface);
    border-color: var(--border);
  }

  .nav-link--active {
    color: var(--gold);
    background: var(--surface2);
    border-color: var(--border-glow);
  }

  /* ── Hamburger ──────────────────────────── */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 8px 10px;
    cursor: pointer;
    flex-shrink: 0;
  }

  .hamburger span {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--muted);
    border-radius: 2px;
    transition: background 0.2s;
  }

  .hamburger:hover span { background: var(--gold); }

  /* ── Mobile Drawer ──────────────────────── */
  .mobile-drawer {
    position: fixed;
    top: 0;
    right: -280px;
    width: 260px;
    height: 100vh;
    background: var(--bg2);
    border-left: 1px solid var(--border);
    z-index: 500;
    display: flex;
    flex-direction: column;
    padding: 24px 20px;
    gap: 6px;
    transition: right 0.3s ease;
  }

  .mobile-drawer.open { right: 0; }

  .drawer-close {
    align-self: flex-end;
    background: none;
    border: 1px solid var(--border);
    color: var(--muted);
    border-radius: var(--radius-sm);
    padding: 6px 12px;
    font-size: 0.9rem;
    cursor: pointer;
    margin-bottom: 16px;
    transition: color 0.2s, border-color 0.2s;
  }

  .drawer-close:hover { color: var(--gold); border-color: var(--gold); }

  .drawer-link {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 12px 16px;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    text-decoration: none;
    transition: color 0.2s, background 0.2s, border-color 0.2s;
  }

  .drawer-link:hover {
    color: var(--gold);
    background: var(--surface);
    border-color: var(--border);
  }

  .drawer-link--active {
    color: var(--gold);
    background: var(--surface2);
    border-color: var(--border-glow);
  }

  .drawer-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: #00000066;
    z-index: 400;
    backdrop-filter: blur(2px);
  }

  .drawer-overlay.open { display: block; }

  /* ── Responsive ─────────────────────────── */
  @media (max-width: 640px) {
    .topbar { padding: 14px 20px; }
    .topbar-nav { display: none; }
    .hamburger { display: flex; }
  }
</style>